---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MelodyFlow | Player" active="player">
	<section class="player card">
		<div class="art"></div>
		<div class="meta">
			<p class="muted">Now playing</p>
			<h1>Midnight Resonance</h1>
			<p class="muted">Ethereal Echoes</p>
		</div>

		<div class="progress">
			<div class="bar"><span></span></div>
			<div class="times muted"><span>1:24</span><span>4:08</span></div>
		</div>

		<div class="controls">
			<button>Shuffle</button>
			<button class="primary">Play</button>
			<button>Repeat</button>
		</div>
	</section>
</Layout>

<style>
	.player {
		padding: 1.2rem;
		display: grid;
		gap: 1rem;
		max-width: 540px;
		margin: 0 auto;
	}

	.art {
		aspect-ratio: 1 / 1;
		border-radius: 1rem;
		background:
			radial-gradient(circle at 28% 22%, rgba(255, 109, 42, 0.5), rgba(255, 109, 42, 0) 45%),
			linear-gradient(145deg, #27455b, #192f3d 60%, #10202c);
		border: 1px solid rgba(154, 178, 193, 0.28);
	}

	h1,
	p {
		margin: 0;
	}

	h1 {
		font-family: 'Space Grotesk', sans-serif;
	}

	.bar {
		height: 0.45rem;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		overflow: hidden;
	}

	.bar span {
		display: block;
		height: 100%;
		width: 33%;
		background: linear-gradient(90deg, var(--accent), var(--accent-soft));
	}

	.times {
		display: flex;
		justify-content: space-between;
		font-size: 0.87rem;
		margin-top: 0.35rem;
	}

	.controls {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
	}

	button {
		border: 0;
		padding: 0.58rem 0.85rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		color: var(--text);
		font-weight: 700;
	}

	button.primary {
		background: linear-gradient(135deg, var(--accent), var(--accent-soft));
		color: #fff;
	}
</style>
