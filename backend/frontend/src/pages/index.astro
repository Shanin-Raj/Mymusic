---
import Layout from '../layouts/Layout.astro';

const featured = [
	{ title: 'Afterglow Circuit', artist: 'Nova Relay', length: '3:52' },
	{ title: 'Quiet Signals', artist: 'Aria Bloom', length: '4:11' },
	{ title: 'Kinetic Bloom', artist: 'Frame Eight', length: '2:58' },
	{ title: 'Low Tide Neon', artist: 'Night Vessel', length: '5:03' }
];
---

<Layout title="MelodyFlow | Home" active="home">
	<section class="hero card">
		<p class="eyebrow">Project 1212269696522831484</p>
		<h1>Flow-first listening UI</h1>
		<p class="muted">A fresh dashboard layout for your Stitch-connected music product with strong hierarchy and quick actions.</p>
		<div class="hero-actions">
			<button>Resume Mix</button>
			<button class="secondary">Open Queue</button>
		</div>
	</section>

	<section class="tracks card">
		<h2 class="section-title">Today Picks</h2>
		<ul>
			{featured.map((song, i) => (
				<li>
					<span class="index">{String(i + 1).padStart(2, '0')}</span>
					<div>
						<strong>{song.title}</strong>
						<p class="muted">{song.artist}</p>
					</div>
					<span class="muted">{song.length}</span>
				</li>
			))}
		</ul>
	</section>
</Layout>

<style>
	.hero,
	.tracks {
		padding: 1.2rem;
	}

	.hero {
		margin-bottom: 1rem;
		background:
			linear-gradient(125deg, rgba(255, 109, 42, 0.16), rgba(20, 36, 45, 0.84)),
			linear-gradient(165deg, var(--panel-soft), var(--panel));
	}

	.eyebrow {
		margin: 0;
		color: var(--accent-soft);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.3rem 0;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.5rem, 3.4vw, 2.1rem);
	}

	.hero-actions {
		display: flex;
		gap: 0.7rem;
		margin-top: 1rem;
	}

	button {
		border: 0;
		border-radius: 0.7rem;
		padding: 0.65rem 0.95rem;
		font-weight: 700;
		color: #fff;
		background: linear-gradient(135deg, var(--accent), var(--accent-soft));
	}

	button.secondary {
		background: rgba(255, 255, 255, 0.08);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	li {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.8rem;
		align-items: center;
		padding: 0.8rem;
		border-radius: 0.8rem;
		background: rgba(255, 255, 255, 0.04);
	}

	li p {
		margin: 0.2rem 0 0;
	}

	.index {
		font-family: 'Space Grotesk', sans-serif;
		color: var(--accent-soft);
	}
</style>
