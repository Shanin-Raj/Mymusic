---
import Layout from '../layouts/Layout.astro';

const options = [
	['Audio quality', 'Very high'],
	['Gapless playback', 'Enabled'],
	['Offline mode', 'Disabled'],
	['Crossfade', '6 seconds']
];
---

<Layout title="MelodyFlow | Settings" active="settings">
	<section class="card settings">
		<h1 class="section-title">Settings</h1>
		<p class="muted">Tune your player behavior and account defaults.</p>
		<div class="rows">
			{options.map(([label, value]) => (
				<div class="row">
					<div>
						<strong>{label}</strong>
						<p class="muted">{value}</p>
					</div>
					<button>Change</button>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	.settings {
		padding: 1.2rem;
	}

	h1,
	p {
		margin-top: 0;
	}

	.rows {
		display: grid;
		gap: 0.7rem;
		margin-top: 0.9rem;
	}

	.row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
		padding: 0.8rem;
		background: rgba(255, 255, 255, 0.04);
		border-radius: 0.75rem;
	}

	strong,
	.row p {
		display: block;
		margin: 0;
	}

	button {
		border: 1px solid rgba(154, 178, 193, 0.24);
		background: rgba(255, 255, 255, 0.06);
		color: var(--text);
		font-weight: 700;
		padding: 0.5rem 0.75rem;
		border-radius: 0.65rem;
	}
</style>
