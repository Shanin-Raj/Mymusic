---
import Layout from '../layouts/Layout.astro';

const chips = ['All', 'Playlists', 'Artists', 'Albums', 'Podcasts', 'Genres'];
const genres = [
	{ name: 'Indie Pulse', tone: 'one' },
	{ name: 'Basement House', tone: 'two' },
	{ name: 'Late Jazz', tone: 'three' },
	{ name: 'Acoustic Calm', tone: 'four' },
	{ name: 'City Pop', tone: 'five' },
	{ name: 'Soundtracks', tone: 'six' }
];
---

<Layout title="MelodyFlow | Search" active="search">
	<section class="search card">
		<h1 class="section-title">Search</h1>
		<input placeholder="Artist, track, or mood" type="text" />
		<div class="chips">
			{chips.map((chip, idx) => (
				<button class={idx === 0 ? 'active' : ''}>{chip}</button>
			))}
		</div>
	</section>

	<section class="card browse">
		<h2 class="section-title">Browse Collections</h2>
		<div class="grid">
			{genres.map((genre) => (
				<article class={`genre ${genre.tone}`}>
					<h3>{genre.name}</h3>
				</article>
			))}
		</div>
	</section>
</Layout>

<style>
	.search,
	.browse {
		padding: 1.2rem;
	}

	.search {
		margin-bottom: 1rem;
	}

	h1,
	h2 {
		margin-top: 0;
	}

	input {
		width: 100%;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(154, 178, 193, 0.2);
		color: var(--text);
		font-size: 1rem;
		padding: 0.78rem 0.95rem;
		border-radius: 0.75rem;
	}

	.chips {
		display: flex;
		gap: 0.55rem;
		margin-top: 0.85rem;
		overflow: auto;
		padding-bottom: 0.2rem;
	}

	.chips button {
		border: 0;
		border-radius: 999px;
		padding: 0.48rem 0.75rem;
		background: rgba(255, 255, 255, 0.08);
		color: var(--text);
		font-weight: 600;
		white-space: nowrap;
	}

	.chips button.active {
		background: linear-gradient(135deg, var(--accent), var(--accent-soft));
		color: #fff;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
	}

	.genre {
		min-height: 6.5rem;
		padding: 0.8rem;
		border-radius: 0.8rem;
		display: flex;
		align-items: flex-end;
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
	}

	.one { background: linear-gradient(145deg, #35546b, #203848); }
	.two { background: linear-gradient(145deg, #5d3f2e, #3d2417); }
	.three { background: linear-gradient(145deg, #4c4068, #2e2646); }
	.four { background: linear-gradient(145deg, #365951, #1e3d35); }
	.five { background: linear-gradient(145deg, #64384c, #462336); }
	.six { background: linear-gradient(145deg, #3e5f78, #233f52); }

	@media (min-width: 760px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
